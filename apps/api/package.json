{
  "name": "@guardiao/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate && tsc --noEmit",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "avaliar": "tsx --env-file-if-exists=../../.env src/avaliacao/medir.ts",
    "carga": "tsx --env-file-if-exists=../../.env src/carga/pitch.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@guardiao/brcode": "workspace:*",
    "@guardiao/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^5.21.1",
    "fastify": "^5.0.0",
    "prisma": "^5.21.1",
    "socket.io": "^4.8.0",
    "tsx": "^4.19.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/web-push": "^3.6.4",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
